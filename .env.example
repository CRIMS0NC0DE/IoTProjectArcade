MQTT_HOST=seu-cluster.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=usuario
MQTT_PASS=senha
MQTT_TOPIC=arcade/scores/submit

# PostgreSQL (Neon: painel do projeto > Connect)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Opcional: credencial própria do backend (subscribe). Sem ela, o backend usa MQTT_USER/MQTT_PASS.
MQTT_BACKEND_USER=arcade-backend
# MQTT_BACKEND_PASS=senha-do-backend  # se omitida, usa MQTT_PASS

# Opcional: chave da API web do RetroAchievements (retroachievements.org > Configurações > Keys).
# Uma só para o arcade inteiro; sem ela, as conquistas aparecem sem ícones e sem a lista completa de cada jogo.
RA_API_KEY=sua-chave-web-api
